# ==============================================================================
# ClimateGuard AI - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO GIT. COPY THIS FILE TO .env AND FILL IN VALUES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External Weather & Environmental APIs
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (Free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Cloud Maps Platform API Key (Air Quality API & Geocoding API)
# Get from GCP Console -> APIs & Services -> Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Google AI Gemini API Key for AI Climate Assistant
# Get from Google AI Studio (https://aistudio.google.com/) or Vertex AI
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase (Database & Persistence)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Safe for public/authenticated client reads)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection URL (from Supabase Settings -> Database -> Connection URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Application Runtime & Flags
# ------------------------------------------------------------------------------
# When DEMO_MODE is true, graceful synthetic fallback data is served if any external API fails or is unconfigured.
DEMO_MODE=false

# Environment: development / production
ENVIRONMENT=development

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed CORS Origins (Frontend URL)
FRONTEND_URL=http://localhost:5173
